# Supabase project configuration. Use the transaction-pooler URL for the dedicated
# rundingan_runtime_web login (member of rundingan_app_limited), never postgres/service_role.
# Keep the database URL and publishable key in local .env.local / deployment secrets, never in Git.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

CRON_SECRET=replace-with-a-long-random-secret
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen2.5:1.5b
